@namespace SwashbucklerDiary.Rcl.Pages
@inherits ImportantComponentBase

<MCard Class="mb-5"
       Elevation="0"
       Rounded="@("lg")">
    <MList Class="py-0">
        <MListItem OnClick="() => showConfig = true">
            <MListItemIcon>
                <MIcon>
                    mdi:mdi-cog-sync-outline
                </MIcon>
            </MListItemIcon>

            <MListItemContent Style="flex-basis:50%;">
                <wc-auto-scroll-text>@(I18n.T("Config"))</wc-auto-scroll-text>
            </MListItemContent>

            <MListItemContent Class="ms-2" Style="flex-basis:50%;">
                <MListItemSubtitle>
                    <wc-auto-scroll-text class="justify-end" style="width:100%;">@ConfiguredText</wc-auto-scroll-text>
                </MListItemSubtitle>
            </MListItemContent>

            <MListItemAction>
                <MIcon>chevron_right</MIcon>
            </MListItemAction>
        </MListItem>

        <MDivider Class="mx-5"></MDivider>

        <MListItem OnClick="OpenUploadDialog">
            <MListItemIcon>
                <MIcon>
                    mdi:mdi-cloud-arrow-up-outline
                </MIcon>
            </MListItemIcon>
            <MListItemContent>
                <MListItemTitle>
                    <wc-auto-scroll-text>@(I18n.T("Upload"))</wc-auto-scroll-text>
                </MListItemTitle>
                <MListItemSubtitle Class="text-caption-xs-only">
                    <wc-auto-scroll-text>@(I18n.T("Upload only changed backup files"))</wc-auto-scroll-text>
                </MListItemSubtitle>
            </MListItemContent>
            <MListItemAction>
                <MIcon>chevron_right</MIcon>
            </MListItemAction>
        </MListItem>

        <MDivider Class="mx-5"></MDivider>

        <MListItem OnClick="SyncDiaries">
            <MListItemIcon>
                <MIcon>
                    mdi:mdi-sync
                </MIcon>
            </MListItemIcon>
            <MListItemContent>
                <MListItemTitle>
                    <wc-auto-scroll-text>@(I18n.T("Sync diaries"))</wc-auto-scroll-text>
                </MListItemTitle>
                <MListItemSubtitle Class="text-caption-xs-only">
                    <wc-auto-scroll-text>@(I18n.T("Experimental incremental diary sync"))</wc-auto-scroll-text>
                </MListItemSubtitle>
            </MListItemContent>
            <MListItemAction>
                <MIcon>chevron_right</MIcon>
            </MListItemAction>
        </MListItem>

        <MDivider Class="mx-5"></MDivider>

        <MListItem>
            <MListItemIcon>
                <MIcon>
                    mdi:mdi-sync-circle
                </MIcon>
            </MListItemIcon>
            <MListItemContent>
                <wc-auto-scroll-text>@(I18n.T("Auto sync diaries"))</wc-auto-scroll-text>
            </MListItemContent>
            <MListItemAction>
                <SettingSwitch @bind-Value="autoSync"
                               SettingKey="@nameof(Setting.WebDAVDiarySyncAuto)">
                </SettingSwitch>
            </MListItemAction>
        </MListItem>

        <MDivider Class="mx-5"></MDivider>

        <MListItem OnClick="ToggleAutoSyncInterval">
            <MListItemIcon>
                <MIcon>
                    mdi:mdi-timer-sync-outline
                </MIcon>
            </MListItemIcon>
            <MListItemContent Style="flex-basis:50%;">
                <wc-auto-scroll-text>@(I18n.T("Auto sync interval"))</wc-auto-scroll-text>
            </MListItemContent>
            <MListItemContent Class="ms-2" Style="flex-basis:50%;">
                <MListItemSubtitle>
                    <wc-auto-scroll-text class="justify-end" style="width:100%;">@AutoSyncIntervalText</wc-auto-scroll-text>
                </MListItemSubtitle>
            </MListItemContent>
            <MListItemAction>
                <MIcon>chevron_right</MIcon>
            </MListItemAction>
        </MListItem>

        <MDivider Class="mx-5"></MDivider>

        <MListItem OnClick="OpenDiagnosticsDialog">
            <MListItemIcon>
                <MIcon>
                    mdi:mdi-cloud-search-outline
                </MIcon>
            </MListItemIcon>
            <MListItemContent>
                <MListItemTitle>
                    <wc-auto-scroll-text>@(I18n.T("Diagnostics"))</wc-auto-scroll-text>
                </MListItemTitle>
                <MListItemSubtitle Class="text-caption-xs-only">
                    <wc-auto-scroll-text>@(I18n.T("Check WebDAV backup status"))</wc-auto-scroll-text>
                </MListItemSubtitle>
            </MListItemContent>
            <MListItemAction>
                <MIcon>chevron_right</MIcon>
            </MListItemAction>
        </MListItem>

        <MDivider Class="mx-5"></MDivider>

        <MListItem OnClick="OpenSyncLogsDialog">
            <MListItemIcon>
                <MIcon>
                    mdi:mdi-text-box-search-outline
                </MIcon>
            </MListItemIcon>
            <MListItemContent>
                <MListItemTitle>
                    <wc-auto-scroll-text>@(I18n.T("Sync logs"))</wc-auto-scroll-text>
                </MListItemTitle>
                <MListItemSubtitle Class="text-caption-xs-only">
                    <wc-auto-scroll-text>@(I18n.T("View recent sync activity"))</wc-auto-scroll-text>
                </MListItemSubtitle>
            </MListItemContent>
            <MListItemAction>
                <MIcon>chevron_right</MIcon>
            </MListItemAction>
        </MListItem>

        <MDivider Class="mx-5"></MDivider>

        <MListItem OnClick="OpenDownloadDialog">
            <MListItemIcon>
                <MIcon>
                    mdi:mdi-cloud-arrow-down-outline
                </MIcon>
            </MListItemIcon>
            <MListItemContent>
                <MListItemTitle>
                    <wc-auto-scroll-text>@(I18n.T("Pull"))</wc-auto-scroll-text>
                </MListItemTitle>
                <MListItemSubtitle Class="text-caption-xs-only">
                    <wc-auto-scroll-text>@(I18n.T("Select an incremental backup point"))</wc-auto-scroll-text>
                </MListItemSubtitle>
            </MListItemContent>
            <MListItemAction>
                <MIcon>chevron_right</MIcon>
            </MListItemAction>
        </MListItem>
    </MList>
</MCard>

<MCard Elevation="0"
       Rounded="@("lg")">
    <MListItem>
        <MListItemIcon>
            <MIcon>
                draft
            </MIcon>
        </MListItemIcon>
        <MListItemContent>
            <wc-auto-scroll-text>@(I18n.T("Include media files"))</wc-auto-scroll-text>
        </MListItemContent>
        <MListItemAction>
            <SettingSwitch @bind-Value="includeDiaryResources"
                           SettingKey="@nameof(Setting.WebDAVCopyResources)">
            </SettingSwitch>
        </MListItemAction>
    </MListItem>
</MCard>

<WebDavConfigDialog @bind-Visible="showConfig"
                    Form="configModel"
                    OnOK="SaveWebDavConfig">
</WebDavConfigDialog>

<CustomMDialog @bind-MyValue="showUpload"
               ContentClass="rounded-lg"
               MaxWidth="420">
    <MCard>
        <MCardTitle Class="font-weight-bold flex-nowrap">
            <wc-auto-scroll-text>@(I18n.T("Upload"))</wc-auto-scroll-text>
            <MSpacer></MSpacer>
            <MButton Icon="true"
                     OnClick="@(()=>showUpload=false)">
                <MIcon>close</MIcon>
            </MButton>
        </MCardTitle>
        <MCardText Class="pb-0">
            @(I18n.T("The data will be saved to an online folder") + webDavFolderName)
        </MCardText>
        <MCardActions>
            <MSpacer></MSpacer>
            <MButton Text="true"
                     OnClick="()=>showUpload=false">
                @(I18n.T("Cancel"))
            </MButton>
            <MButton Text="true"
                     Color="primary"
                     OnClick="Upload">
                @(I18n.T("OK"))
            </MButton>
        </MCardActions>
    </MCard>
</CustomMDialog>

<CustomMDialog @bind-MyValue="showSyncLogs"
               ContentClass="rounded-lg"
               MaxWidth="520"
               Scrollable="true">
    <MCard>
        <MCardTitle Class="font-weight-bold flex-nowrap">
            <wc-auto-scroll-text>@(I18n.T("Sync logs"))</wc-auto-scroll-text>
            <MSpacer></MSpacer>
            <MButton Icon="true"
                     OnClick="()=>showSyncLogs=false">
                <MIcon>close</MIcon>
            </MButton>
        </MCardTitle>
        <MCardText Class="pb-0 px-0 mb-5 d-flex flex-column">
            @if (syncLogs.Count == 0)
            {
                <MListItem>
                    <MListItemAvatar>
                        <MIcon>mdi:mdi-text-box-remove-outline</MIcon>
                    </MListItemAvatar>
                    <MListItemContent>
                        <MListItemTitle>@I18n.T("No sync logs")</MListItemTitle>
                    </MListItemContent>
                </MListItem>
            }
            <MList Class="py-0 scroll-show flex-grow-1"
                   Style="overflow-y:auto;">
                <Virtualize Items="syncLogs"
                            ItemSize="76"
                            Context="item"
                            OverscanCount="20">
                    <MListItem Class="rounded">
                        <MListItemAvatar>
                            <MIcon>@GetSyncLogIcon(item)</MIcon>
                        </MListItemAvatar>
                        <MListItemContent>
                            <MListItemTitle Class="two-line">@GetSyncLogTitle(item)</MListItemTitle>
                            <MListItemSubtitle>@item.CreateTime.ToString("yyyy-MM-dd HH:mm:ss")</MListItemSubtitle>
                            <MListItemSubtitle>@GetSyncLogSubtitle(item)</MListItemSubtitle>
                        </MListItemContent>
                    </MListItem>
                </Virtualize>
            </MList>
        </MCardText>
    </MCard>
</CustomMDialog>

<CustomMDialog @bind-MyValue="showDiagnostics"
               ContentClass="rounded-lg"
               MaxWidth="420">
    <MCard>
        <MCardTitle Class="font-weight-bold flex-nowrap">
            <wc-auto-scroll-text>@(I18n.T("Diagnostics"))</wc-auto-scroll-text>
            <MSpacer></MSpacer>
            <MButton Icon="true"
                     OnClick="()=>showDiagnostics=false">
                <MIcon>close</MIcon>
            </MButton>
        </MCardTitle>
        <MCardText Class="px-0 pb-0">
            <MList Class="py-0">
                <MListItem>
                    <MListItemContent>
                        <MListItemTitle>@I18n.T("Status")</MListItemTitle>
                    </MListItemContent>
                    <MListItemActionText>@DiagnosticsStatusText</MListItemActionText>
                </MListItem>
                <MDivider Class="mx-5"></MDivider>
                <MListItem>
                    <MListItemContent>
                        <MListItemTitle>@I18n.T("Incremental backup")</MListItemTitle>
                    </MListItemContent>
                    <MListItemActionText>@(diagnostics?.IncrementalBackupCount ?? 0)</MListItemActionText>
                </MListItem>
                <MDivider Class="mx-5"></MDivider>
                <MListItem>
                    <MListItemContent>
                        <MListItemTitle>@I18n.T("Legacy backup")</MListItemTitle>
                    </MListItemContent>
                    <MListItemActionText>@(diagnostics?.LegacyBackupCount ?? 0)</MListItemActionText>
                </MListItem>
                <MDivider Class="mx-5"></MDivider>
                <MListItem>
                    <MListItemContent>
                        <MListItemTitle>@I18n.T("Latest backup")</MListItemTitle>
                    </MListItemContent>
                    <MListItemActionText>@DiagnosticsLatestBackupTimeText</MListItemActionText>
                </MListItem>
                <MDivider Class="mx-5"></MDivider>
                <MListItem>
                    <MListItemContent>
                        <MListItemTitle>@I18n.T("Total size")</MListItemTitle>
                    </MListItemContent>
                    <MListItemActionText>@DiagnosticsTotalSizeText</MListItemActionText>
                </MListItem>
                @if (!string.IsNullOrWhiteSpace(diagnostics?.ErrorMessage))
                {
                    <MDivider Class="mx-5"></MDivider>
                    <MListItem>
                        <MListItemContent>
                            <MListItemTitle>@I18n.T("Error")</MListItemTitle>
                            <MListItemSubtitle>@diagnostics.ErrorMessage</MListItemSubtitle>
                        </MListItemContent>
                    </MListItem>
                }
            </MList>
        </MCardText>
    </MCard>
</CustomMDialog>

<CustomMDialog @bind-MyValue="showDownload"
               ContentClass="rounded-lg"
               MaxWidth="420"
               Scrollable="true">
    <MCard>
        <MCardTitle Class="font-weight-bold flex-nowrap">
            <wc-auto-scroll-text>@(I18n.T("Pull"))</wc-auto-scroll-text>
            <MSpacer></MSpacer>
            <MButton Icon="true"
                     OnClick="()=>showDownload=false">
                <MIcon>close</MIcon>
            </MButton>
        </MCardTitle>
        <MCardText Class="pb-0 px-0 mb-5 d-flex flex-column">
            @if (backupManifests.Count == 0)
            {
                <MListItem>
                    <MListItemAvatar>
                        <MIcon>mdi:mdi-cloud-question-outline</MIcon>
                    </MListItemAvatar>
                    <MListItemContent>
                        <MListItemTitle>@I18n.T("No backup")</MListItemTitle>
                    </MListItemContent>
                </MListItem>
            }
            <MList Class="py-0 scroll-show flex-grow-1"
                   Style="overflow-y:auto;">
                <Virtualize Items="backupManifests"
                            ItemSize="64"
                            Context="item"
                            OverscanCount="30">
                    <MListItem Class="rounded"
                               OnClick="()=>Download(item)">
                        <MListItemAvatar>
                            <MIcon>
                                @GetBackupIcon(item)
                            </MIcon>
                        </MListItemAvatar>

                        <MListItemContent>
                            <MListItemTitle Class="two-line">@GetBackupTime(item)</MListItemTitle>

                            <MListItemSubtitle>@GeFileSize(item) / @I18n.T("File"): @GetFileCount(item)</MListItemSubtitle>
                        </MListItemContent>

                        <MListItemAction>
                            <MButton Icon>
                                <MIcon>download</MIcon>
                            </MButton>
                        </MListItemAction>
                    </MListItem>
                </Virtualize>
            </MList>
        </MCardText>
    </MCard>
</CustomMDialog>
